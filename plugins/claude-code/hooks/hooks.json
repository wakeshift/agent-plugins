{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wakeshift", "hook", "--harness", "claude-code", "--event", "claim"],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wakeshift", "hook", "--harness", "claude-code", "--event", "subagent-context"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wakeshift", "hook", "--harness", "claude-code"],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wakeshift", "hook", "--harness", "claude-code", "--event", "session-context"],
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wakeshift", "hook", "--harness", "claude-code", "--rewake"],
            "asyncRewake": true,
            "rewakeSummary": "Woken by Wakeshift",
            "rewakeMessage": "Wakeshift woke this session (not the user).",
            "timeout": 86400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wakeshift", "hook", "--harness", "claude-code", "--rewake"],
            "asyncRewake": true,
            "rewakeSummary": "Woken by Wakeshift",
            "rewakeMessage": "Wakeshift woke this session (not the user).",
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
