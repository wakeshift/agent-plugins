# Wakeshift's plugin for copilot: the Wakeshift it trusts, and the connector its
# hooks run (bin/wakeshift fetches it from connector_url and checks it against SHA256SUMS).
# Written by opensource/export.sh agent-plugins in github.com/wakeshift/wakeshift.
harness=copilot
issuer=https://app.wakeshift.ai
connector_version=2026.11.06.1920+45b058c
connector_url=https://github.com/wakeshift/connectors/releases/download/v1.4.33
